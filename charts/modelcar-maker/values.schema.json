{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "modelcar-maker chart values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "huggingFace": {
      "type": "object",
      "properties": { "token": { "type": "string" } },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
        "manifestHash": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "additionalProperties": true
    },
    "verbosity": { "type": "integer", "minimum": 0, "maximum": 3 },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "tag": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" },
          "hidden": { "type": "boolean" }
        },
        "required": ["repo"],
        "additionalProperties": true
      }
    },
    "modelcar": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 }
          },
          "required": ["registry", "repository"],
          "additionalProperties": true
        },
        "imageStream": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "name": { "type": "string" },
            "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          },
          "additionalProperties": true
        },
        "dockerConfigJson": { "type": "string" },
        "skipIfExists": { "type": "boolean" },
        "baseImage": { "type": "string", "minLength": 1 },
        "baseImagePull": { "type": "boolean" },
        "cleanup": { "type": "boolean" },
        "maintainer": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      },
      "additionalProperties": true
    },
    "certificateAuthorities": {
      "type": "object",
      "properties": {
        "openshiftClusterCa": { "type": "boolean" },
        "custom": { "type": "string" }
      },
      "additionalProperties": true
    },
    "dataScienceConnections": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "namespace": { "type": "string" }
      },
      "additionalProperties": true
    },
    "imagePuller": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "updateStrategy": { "type": "object" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "properties": {
        "type": { "enum": ["emptyDir", "pvc"] },
        "emptyDir": {
          "type": "object",
          "properties": {
            "medium": { "enum": ["", "Memory"] },
            "sizeLimit": { "$ref": "#/definitions/quantity" }
          },
          "additionalProperties": true
        },
        "pvc": {
          "type": "object",
          "properties": {
            "size": { "$ref": "#/definitions/quantity" },
            "storageClassName": { "type": "string" },
            "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "volumeName": { "type": "string" },
            "selector": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": true
        },
        "modelCleanup": { "type": "boolean" }
      },
      "required": ["type"],
      "additionalProperties": true,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "pvc" } }, "required": ["type"] },
          "then": { "required": ["pvc"] }
        }
      ]
    },
    "backoffLimit": { "type": "integer", "minimum": 0 },
    "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
    "securityContext": { "$ref": "#/definitions/containerSecurityContext" },
    "resources": { "$ref": "#/definitions/resources" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "quantity": {
      "type": ["string", "number"]
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/quantity" }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": { "$ref": "#/definitions/resourceList" },
        "requests": { "$ref": "#/definitions/resourceList" }
      },
      "additionalProperties": true
    },
    "seccompProfile": {
      "type": "object",
      "properties": {
        "type": { "enum": ["RuntimeDefault", "Localhost", "Unconfined"] },
        "localhostProfile": { "type": "string" }
      },
      "additionalProperties": true
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "runAsNonRoot": { "type": "boolean" },
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "enum": ["OnRootMismatch", "Always"] },
        "supplementalGroups": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "supplementalGroupsPolicy": { "enum": ["Merge", "Strict"] },
        "seccompProfile": { "$ref": "#/definitions/seccompProfile" },
        "seLinuxOptions": { "type": "object", "additionalProperties": { "type": "string" } },
        "sysctls": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "value": { "type": "string" } }, "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "containerSecurityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "privileged": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "runAsNonRoot": { "type": "boolean" },
        "procMount": { "type": "string" },
        "capabilities": { "type": "object", "properties": { "add": { "type": "array", "items": { "type": "string" } }, "drop": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
        "seccompProfile": { "$ref": "#/definitions/seccompProfile" },
        "seLinuxOptions": { "type": "object", "additionalProperties": { "type": "string" } },
        "windowsOptions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
